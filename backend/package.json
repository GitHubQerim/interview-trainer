{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "description": "Interview-Trainer Backend (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "oxlint": "^1.83.0",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
